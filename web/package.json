{
  "name": "modeldock-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src e2e *.ts *.json *.js",
    "format:check": "prettier --check src e2e *.ts *.json *.js",
    "test:e2e:providers": "playwright test --config playwright.providers.config.ts"
  },
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "@tanstack/react-query": "5.74.4",
    "antd": "5.24.8",
    "i18next": "25.0.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-i18next": "15.4.1",
    "react-router-dom": "7.5.1"
  },
  "devDependencies": {
    "@eslint/js": "9.24.0",
    "@playwright/test": "1.51.1",
    "@types/node": "22.14.1",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.4.1",
    "eslint": "9.24.0",
    "globals": "16.0.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.30.1",
    "vite": "6.3.5",
    "vitest": "3.1.1",
    "swagger-ui-dist": "5.21.0",
    "prettier": "3.5.3"
  }
}
