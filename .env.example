# Set a unique administrator password (at least 12 characters) before first boot.
MODELDock_ADMIN_USERNAME=admin
MODELDock_ADMIN_PASSWORD=
MODELDock_DATABASE_URL=postgresql+asyncpg://modeldock:modeldock@localhost:5432/modeldock
MODELDock_REDIS_URL=redis://localhost:6379/0
MODELDock_DATA_DIR=./data
MODELDock_MODELS_DIR=./models
# Optional model downloads run in the Worker, only after an admin clicks Download.
MODELDock_MODEL_HUB_URL=https://huggingface.co
MODELDock_MODEL_DOWNLOAD_MAX_GB=10
MODELDock_MODEL_DOWNLOAD_TIMEOUT_SECONDS=7200
# Set true before docker compose build to include optional speech engine dependencies.
MODELDock_SPEECH=false
MODELDock_SECURE_COOKIE=false
MODELDock_SESSION_HOURS=12
MODELDock_FILE_RETENTION_DAYS=7
MODELDock_LOG_RETENTION_DAYS=30
MODELDock_VIRTUAL_GPU_MB=24576
MODELDock_UPLOAD_MAX_MB=25
MODELDock_PORT=8000
POSTGRES_PASSWORD=modeldock

# Optional provider credentials. Models store these names, never their values.
# Export these for a standalone Worker; Compose injects .env into the Worker.
# MODELDock_CHAT_KEY=
# MODELDock_RUNNINGHUB_KEY=
# MODELDock_VOLC_APPID=
# MODELDock_VOLC_TOKEN=

# Optional: persistent Fernet master key shared by API and Worker for UI-managed
# provider credentials. Generate once with Fernet.generate_key(); back up separately.
# Missing/invalid keys disable credential storage, but Mock and env-based adapters work.
MODELDock_PROVIDER_ENCRYPTION_KEY=
